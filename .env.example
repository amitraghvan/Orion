# ==============================================================================
# ORION BAS AI Copilot — Environment Configuration Template
# Spacecraft / Ground Station Deployment Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# SYSTEM IDENTITY & ENVIRONMENT
# ------------------------------------------------------------------------------
# Environment mode: development | testing | staging | production
ORION_ENV=development

# Station subsystem identifier: BAS-MODULE-CORE | BAS-MODULE-SCIENCE | GROUND-TESTBED
ORION_STATION_ID=BAS-SCIENCE-NODE-01

# Application version tag
ORION_VERSION=0.1.0-alpha.0

# Deterministic seed for reproducible evaluation and mock generation
ORION_SEED=42

# ------------------------------------------------------------------------------
# API & NETWORKING
# ------------------------------------------------------------------------------
# Host interface to bind. Use 127.0.0.1 for local isolation, 0.0.0.0 for containerized deployments
ORION_API_HOST=127.0.0.1

# HTTP / REST API port
ORION_API_PORT=8000

# Number of async worker processes for Uvicorn
ORION_API_WORKERS=1

# Allowed CORS origins (comma separated or JSON array)
ORION_API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Secret key used for cryptographic JWT signing and session validation (MUST be populated with 64+ char random secret in production)
# Generate with: openssl rand -hex 32
ORION_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_KEY_MIN_32_CHARS

# ------------------------------------------------------------------------------
# DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# Async database connection URL.
# SQLite async format: sqlite+aiosqlite:////absolute/path/to/orion.db
# PostgreSQL async format: postgresql+asyncpg://user:password@host:5432/dbname
ORION_DATABASE_URL=sqlite+aiosqlite:///./orion_dev.db

# Database connection pool settings
ORION_DB_POOL_SIZE=5
ORION_DB_MAX_OVERFLOW=10
ORION_DB_POOL_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
ORION_LOG_LEVEL=INFO

# Log output format: json | console | pretty
ORION_LOG_FORMAT=console

# Rotating log file path. If empty, logs only to stdout
ORION_LOG_FILE=./logs/orion.log
ORION_LOG_ROTATION_BYTES=52428800 # 50 MB
ORION_LOG_BACKUP_COUNT=10

# Prometheus metrics exposure port (internal air-gapped network)
ORION_METRICS_ENABLED=true
ORION_METRICS_PORT=9090

# OpenTelemetry tracing endpoint (optional)
ORION_OTEL_EXPORTER_ENDPOINT=

# ------------------------------------------------------------------------------
# HARDWARE & ACCELERATION PROFILES
# ------------------------------------------------------------------------------
# Hardware acceleration backend: cpu | cuda | mps | rocm | tensorrt | openvino
ORION_HARDWARE_ACCELERATOR=cpu

# Target primary GPU device index
ORION_GPU_DEVICE_INDEX=0

# Max GPU memory allocation fraction (0.1 to 0.95)
ORION_GPU_MEMORY_FRACTION=0.75

# ------------------------------------------------------------------------------
# CAMERA & SENSOR SUBSYSTEM
# ------------------------------------------------------------------------------
# Primary camera device index (0, 1...) or RTSP URI (e.g., rtsp://192.168.1.100:554/feed)
ORION_CAMERA_SOURCE=0

# Camera target resolution
ORION_CAMERA_WIDTH=1920
ORION_CAMERA_HEIGHT=1080

# Sensor capture target frames per second
ORION_CAMERA_FPS=30

# Max frame buffer queue size in memory before dropping oldest frames
ORION_CAMERA_BUFFER_SIZE=60

# ------------------------------------------------------------------------------
# RECORDING & STORAGE SUBSYSTEM
# ------------------------------------------------------------------------------
# Base path for persistent experiment video recordings and telemetry bags
ORION_RECORDING_STORAGE_PATH=./data/recordings

# Max continuous segment duration in seconds before video file rotation
ORION_RECORDING_SEGMENT_DURATION_SECONDS=600

# Minimum remaining disk space in megabytes before emergency recording halt
ORION_RECORDING_MIN_DISK_FREE_MB=5120

# ------------------------------------------------------------------------------
# AUDIO & MISSION ALERT SYSTEM
# ------------------------------------------------------------------------------
# Enable synthesized audio and alert announcements
ORION_AUDIO_ENABLED=false

# Master alert volume (0.0 to 1.0)
ORION_AUDIO_VOLUME=0.8

# Cooldown duration in seconds between identical audio alerts
ORION_AUDIO_ALERT_COOLDOWN_SECONDS=10.0
