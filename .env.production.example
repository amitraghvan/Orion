# ==============================================================================
# ORION BAS AI Copilot — Production Flight / Station Configuration Template
# ==============================================================================
ORION_ENV=production
ORION_STATION_ID=BAS-SCIENCE-CORE-MODULE
ORION_VERSION=1.0.0
ORION_SEED=1337

ORION_API_HOST=0.0.0.0
ORION_API_PORT=8000
ORION_API_WORKERS=4
ORION_API_CORS_ORIGINS=["https://bas.mission.isro.gov.in","https://telemetry.bas.local"]
# CRITICAL: Must be populated with 64-char cryptographically secure key via hardware HSM or vault
ORION_SECRET_KEY=REPLACE_WITH_AEROSPACE_HSM_DERIVED_PRODUCTION_SECRET_KEY_64_CHARS

ORION_DATABASE_URL=postgresql+asyncpg://orion_app:SECURE_DB_PASSWORD@station-db.internal:5432/orion_telemetry
ORION_DB_POOL_SIZE=20
ORION_DB_MAX_OVERFLOW=10
ORION_DB_POOL_TIMEOUT=60.0

ORION_LOG_LEVEL=INFO
ORION_LOG_FORMAT=json
ORION_LOG_FILE=/var/log/orion/orion_flight.log
ORION_LOG_ROTATION_BYTES=104857600
ORION_LOG_BACKUP_COUNT=20

ORION_METRICS_ENABLED=true
ORION_METRICS_PORT=9090
ORION_OTEL_EXPORTER_ENDPOINT=http://otel-collector.internal:4317

ORION_HARDWARE_ACCELERATOR=cuda
ORION_GPU_DEVICE_INDEX=0
ORION_GPU_MEMORY_FRACTION=0.85

ORION_CAMERA_SOURCE=rtsp://10.20.1.50:554/bas/experiment_cam_01
ORION_CAMERA_WIDTH=1920
ORION_CAMERA_HEIGHT=1080
ORION_CAMERA_FPS=60
ORION_CAMERA_BUFFER_SIZE=120

ORION_RECORDING_STORAGE_PATH=/mnt/nvme_storage/bas/recordings
ORION_RECORDING_SEGMENT_DURATION_SECONDS=1800
ORION_RECORDING_MIN_DISK_FREE_MB=51200

ORION_AUDIO_ENABLED=true
ORION_AUDIO_VOLUME=0.85
ORION_AUDIO_ALERT_COOLDOWN_SECONDS=15.0
