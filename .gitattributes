# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text eol=lf diff=python
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.sh text eol=lf eol=lf
*.ps1 text eol=crlf
*.sql text eol=lf

# Denote binary files (do not touch line endings, prevent diff corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.onnx binary
*.pt binary
*.pth binary
*.engine binary
*.tar.gz binary
*.zip binary
*.parquet binary
