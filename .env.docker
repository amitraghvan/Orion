# ==============================================================================
# ORION BAS AI Copilot — Docker Environment Overrides
# Copy or symlink to .env for containerized execution: cp .env.docker .env
# ==============================================================================

# Core Application Mode
ORION_ENV=development
ORION_STATION_ID=BAS-SCIENCE-NODE-01
ORION_VERSION=0.1.0-alpha.0
ORION_SEED=42

# API Server Binding (0.0.0.0 required inside containers)
ORION_API_HOST=0.0.0.0
ORION_API_PORT=8000
ORION_API_WORKERS=1
ORION_API_CORS_ORIGINS=["*"]
ORION_SECRET_KEY=dev_secret_key_bas_orion_offline_32_characters_minimum

# Persistence & Storage
ORION_DATABASE_URL=sqlite+aiosqlite:////app/data/orion.db
ORION_RECORDING_STORAGE_PATH=/app/recordings

# Logging & Observability
ORION_LOG_LEVEL=INFO
ORION_LOG_FORMAT=console
ORION_LOG_FILE=/app/logs/orion.log
ORION_METRICS_ENABLED=true
ORION_METRICS_PORT=9090

# Hardware Acceleration Profile (cpu, cuda, or mps)
ORION_HARDWARE_ACCELERATOR=cpu

# Camera & Ingestion Subsystem (uses bundled sample replay video by default in containers)
ORION_CAMERA_SOURCE=assets/sample_replay.mp4
ORION_CAMERA_WIDTH=1920
ORION_CAMERA_HEIGHT=1080
ORION_CAMERA_FPS=30

# Live Video Stream (serves multipart MJPEG on port 8080)
ORION_STREAMING_ENABLED=true
ORION_STREAMING_PORT=8080

# Audio & Speech
ORION_AUDIO_ENABLED=false
