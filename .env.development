# ==============================================================================
# ORION BAS AI Copilot — Development Environment Configuration
# ==============================================================================
ORION_ENV=development
ORION_STATION_ID=BAS-DEV-BENCH-01
ORION_VERSION=0.1.0-alpha.0
ORION_SEED=42

ORION_API_HOST=127.0.0.1
ORION_API_PORT=8000
ORION_API_WORKERS=1
ORION_API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
ORION_SECRET_KEY=dev-aerospace-insecure-secret-key-for-local-testing-only-32chars

ORION_DATABASE_URL=sqlite+aiosqlite:///./data/orion_dev.db
ORION_DB_POOL_SIZE=5
ORION_DB_MAX_OVERFLOW=5
ORION_DB_POOL_TIMEOUT=30.0

ORION_LOG_LEVEL=DEBUG
ORION_LOG_FORMAT=pretty
ORION_LOG_FILE=./logs/orion_dev.log
ORION_LOG_ROTATION_BYTES=10485760
ORION_LOG_BACKUP_COUNT=5

ORION_METRICS_ENABLED=true
ORION_METRICS_PORT=9090
ORION_OTEL_EXPORTER_ENDPOINT=

ORION_HARDWARE_ACCELERATOR=cpu
ORION_GPU_DEVICE_INDEX=0
ORION_GPU_MEMORY_FRACTION=0.5

ORION_CAMERA_SOURCE=0
ORION_CAMERA_WIDTH=1280
ORION_CAMERA_HEIGHT=720
ORION_CAMERA_FPS=30
ORION_CAMERA_BUFFER_SIZE=30

ORION_RECORDING_STORAGE_PATH=./data/recordings
ORION_RECORDING_SEGMENT_DURATION_SECONDS=300
ORION_RECORDING_MIN_DISK_FREE_MB=1024

ORION_AUDIO_ENABLED=false
ORION_AUDIO_VOLUME=0.5
ORION_AUDIO_ALERT_COOLDOWN_SECONDS=5.0
